# Server-Presets für den Modus „Server“ (SPEC-0005). Kopieren nach .env.local (gitignoriert)
# und anpassen. API-Keys gehören NICHT hierher: Vite baut VITE_-Variablen ins Bundle ein.
# Ohne apiKey fragt die App den Key ab und merkt ihn sich nicht.
VITE_REMOTE_PRESETS='[{"name":"Lokaler MLX-Server","baseUrl":"http://localhost:8080/v1","model":"mlx-community/Qwen3.5-35B-A3B-OptiQ-4bit","dialect":"content"},{"name":"vLLM in der Cloud","baseUrl":"https://llm.example/v1","model":"Qwen3.5-0.8B","dialect":"legacy"}]'
